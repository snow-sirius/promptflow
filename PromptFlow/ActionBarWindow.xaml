<Window x:Class="PromptFlow.ActionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="360" Height="52" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="12" Padding="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54"/>
                <ColumnDefinition Width="54"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="历史" Click="History_Click" Width="54" Height="36" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="历史"/>
            <Button Grid.Column="1" Content="收藏" Click="Favorites_Click" Width="54" Height="36" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="收藏夹"/>
            <ScrollViewer Grid.Column="2" x:Name="RecentFoldersScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="3,0" Focusable="False" PanningMode="HorizontalOnly" CanContentScroll="False">
                <StackPanel x:Name="RecentFoldersPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
