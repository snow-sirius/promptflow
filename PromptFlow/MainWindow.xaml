<Window x:Class="PromptFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PromptFlow.Models"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="360" Height="260" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Loaded="Window_Loaded">
    <Window.Resources>
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type models:ClipboardItem}">
            <Border Height="66" HorizontalAlignment="Stretch" Margin="0,2" Padding="8,6" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="8"
                    MouseEnter="Item_MouseEnter" MouseLeave="Item_MouseLeave" MouseLeftButtonUp="Item_MouseLeftButtonUp"
                    AllowDrop="True" DragOver="ItemCard_DragOver" DragLeave="ItemCard_DragLeave" Drop="ItemCard_Drop">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding ImagePng, Converter={StaticResource ByteArrayToImageConverter}}" Width="48" Height="48" Stretch="UniformToFill" Margin="0,0,8,0" Visibility="{Binding ImagePng, Converter={StaticResource ImageBytesVisibilityConverter}}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Preview}" FontSize="13" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                        <TextBlock Text="{Binding LastCopiedAt, StringFormat={}{0:MM-dd HH:mm}}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Tag="{Binding}" Content="{Binding IsFavorite, Converter={StaticResource BoolToStarConverter}}" Click="Favorite_Click" Width="30" Height="28" Padding="0" ToolTip="收藏到收藏夹" Foreground="{StaticResource AccentBrush}" FontSize="16"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="FolderTemplate" DataType="{x:Type models:Folder}">
            <Border Height="52" HorizontalAlignment="Stretch" Padding="9,7" Margin="0,2" BorderThickness="1" CornerRadius="7"
                    MouseLeftButtonUp="Folder_MouseLeftButtonUp" AllowDrop="True" DragOver="FolderCard_DragOver" DragLeave="FolderCard_DragLeave" Drop="FolderCard_Drop">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="Background" Value="#E3F1F3"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding ItemCount}" Foreground="{StaticResource MutedBrush}" Margin="8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding IsLocked, Converter={StaticResource BoolToLockConverter}}" VerticalAlignment="Center"/></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
        <Grid>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="22"/></Grid.RowDefinitions>
            <Grid x:Name="HistoryContent">
                <ListBox x:Name="ItemList" ItemsSource="{Binding}" ItemTemplate="{StaticResource ItemTemplate}" Background="Transparent" BorderThickness="0" Padding="0,1,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                         HorizontalContentAlignment="Stretch" AllowDrop="True" Drop="ItemList_Drop" DragOver="ItemList_DragOver" PreviewMouseWheel="List_PreviewMouseWheel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PromptFlowListBoxItem}">
                            <Setter Property="Height" Value="68"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
            <Grid x:Name="FavoritesContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <ListBox x:Name="FolderList" Grid.Column="0" ItemsSource="{Binding}" ItemTemplate="{StaticResource FolderTemplate}" SelectionChanged="FolderList_SelectionChanged"
                         Background="Transparent" BorderThickness="0" AllowDrop="True" Drop="FolderList_Drop" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch" DragOver="FolderList_DragOver" PreviewMouseWheel="List_PreviewMouseWheel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PromptFlowListBoxItem}">
                            <Setter Property="Height" Value="56"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Border Grid.Column="1" Background="{StaticResource OutlineBrush}" Width="1" HorizontalAlignment="Center"/>
                <ListBox x:Name="FavoriteItemList" Grid.Column="2" ItemsSource="{Binding}" ItemTemplate="{StaticResource ItemTemplate}" Background="Transparent" BorderThickness="0"
                         AllowDrop="True" Drop="FavoriteItemList_Drop" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch" DragOver="FavoriteItemList_DragOver" PreviewMouseWheel="List_PreviewMouseWheel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PromptFlowListBoxItem}">
                            <Setter Property="Height" Value="68"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,0" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
