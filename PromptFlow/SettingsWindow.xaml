<Window x:Class="PromptFlow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PromptFlow 设置" Width="560" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F7F8FC" WindowStyle="None" AllowsTransparency="True">
    <Border Background="#F7F8FC" BorderBrush="#172033" BorderThickness="1" CornerRadius="14" Padding="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="52"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                <Button Content="×" Width="34" Height="30" Padding="0" HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,8,0,0">
                    <CheckBox x:Name="AutoStartCheck" Content="开机自启动" FontSize="14" Margin="0,8"/>
                    <CheckBox x:Name="MonitorCheck" Content="监听剪贴板" FontSize="14" Margin="0,8"/>
                    <TextBlock Text="全局快捷键" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/>
                    <TextBox x:Name="HotkeyBox" IsReadOnly="True" Focusable="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown" ToolTip="点击后按下快捷键组合进行录入"/>
                    <TextBlock Text="点击输入框后按下组合键录入，支持 Ctrl / Alt / Shift / Win 与键盘按键或鼠标侧键，例如 Ctrl+XButton1" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="最大历史条数" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/>
                    <TextBox x:Name="MaxHistoryBox"/>
                    <TextBlock Text="数据保存目录" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/>
                    <DockPanel><TextBox x:Name="DataPathBox"/><Button Content="浏览" DockPanel.Dock="Right" Width="66" Click="ChoosePath_Click"/></DockPanel>
                    <TextBlock Text="排除应用（每行一个进程名）" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/>
                    <TextBox x:Name="ExclusionsBox" Height="74" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="清空未收藏历史" HorizontalAlignment="Left" Margin="0,16,0,4" Click="ClearHistory_Click"/>
                    <TextBlock Text="图片超过 10 MB 时不会保存，以避免数据库异常膨胀。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="恢复默认" Width="90" Click="Reset_Click"/>
                <Button Content="取消" Width="80" Click="Close_Click"/>
                <Button Content="保存" Width="80" Background="{StaticResource AccentBrush}" Foreground="White" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
